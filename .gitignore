.u2net/
.cache/

# Datasets & Training Exports
ai-service/data/*
!ai-service/data/.gitkeep
data/*
!data/.gitkeep
*.csv
*.tsv
*.jsonl

# Temporary audio inputs for Speech-to-Text (STT)
*.wav
*.mp3
*.webm
*.ogg
*.m4a
*.flac

